# KSPDB System Configuration

# Database
POSTGRES_USER=kspdb_admin
POSTGRES_PASSWORD=kspdb_secret_pass
POSTGRES_DB=kspdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://kspdb_admin:kspdb_secret_pass@postgres:5432/kspdb

# Backend Service
PORT=4000
NODE_ENV=production

# AI / LLM Integration (Optional)
# Leave blank or omit if not testing LLM summary feature. System will fallback to template summary gracefully.
GEMINI_API_KEY=

# Frontend Service
NEXT_PUBLIC_API_URL=http://localhost:4000
